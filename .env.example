# Auto-generate SSH keys during workspace prep (YES/NO)
CONTEXT_AUTO_GENERATE_SSH_KEYS="YES"
# Auto-generate VM passwords during workspace prep (YES/NO)
CONTEXT_AUTO_GENERATE_VM_PASSWORDS="YES"
# Number of additional student SSH keys to generate
STUDENT_ADDITIONNAL_KEYS_COUNT="5"
# Local workstation SSH config directory
SSH_CLIENT_DST_CONFIG_DIR="/home/range42-operator/.ssh"
# Infrastructure identifier (max ~6 chars recommended)
INFRASTRUCTURE_CODENAME="hv-hx"
# Scenario name to deploy
INFRASTRUCTURE_SCENARIO="demo_lab"
# Proxmox management IP/host
INFRASTRUCTURE_PROXMOX_ADDRESS="10.0.0.10"
# Proxmox storage for ISO/cloud-init images
INFRASTRUCTURE_PROXMOX_DEST_ISO_STORAGE_NAME="local"
# Proxmox storage for VM disks
INFRASTRUCTURE_PROXMOX_DEST_VM_STORAGE_NAME="local-lvm"
# Proxmox NIC interface used for NAT networks
INFRASTRUCTURE_PROXMOX_DEFAULT_NETWORK_CARD_INTERFACE="enp3s0"
# Deployer-cli VM IP address
DEPLOYER_CLI_IP="10.0.0.11"
# Deployer-cli SSH port
DEPLOYER_CLI_SSH_PORT="22"
# Deployer-cli SSH username
DEPLOYER_CLI_USER="range42-operator"
# Known-hosts file path on deployer-cli VM
DEPLOYER_CLI_USER_SSH_KNOWN_HOSTS="/home/range42-operator/.ssh/known_hosts"
# Proxmox API endpoint (host:port)
PROXMOX_API_HOST="10.0.0.10:8006"
# Proxmox API user
PROXMOX_API_USER="root@pam"
# Proxmox API token id
PROXMOX_API_TOKEN_ID="range42_api_main"
# Proxmox API token secret
PROXMOX_API_TOKEN_SECRET="<proxmox_api_token_secret>"
# Proxmox node name (must match cluster node)
PROXMOX_NODE="hv-hx"
# Whether to use a jump host (YES/NO)
JUMP_ON_PROXMOX="YES"
# Jump host address (defaults to Proxmox host)
JUMP_HOST="10.0.0.10"
# Jump host SSH user
JUMP_USER="jump_user"
# Jump host SSH port
JUMP_PORT="22"
# Jump host password (base64 or plaintext, per your workflow)
JUMP_PASSWORD="<jump_password>"
# Default cloud-init admin user for deployer VM
DEFAULT_ADMIN_VM_CI_USER="alice"
# Default cloud-init admin password
DEFAULT_ADMIN_VM_CI_PASSWORD="<admin_vm_ci_password>"
# Default cloud-init admin SSH public key
DEFAULT_ADMIN_VM_CI_SSH_KEY="<admin_vm_ci_ssh_key>"
# Default cloud-init trainee user
DEFAULT_TRAINEE_VM_CI_USER="bob"
# Default cloud-init trainee password
DEFAULT_TRAINEE_VM_CI_PASSWORD="<trainee_vm_ci_password>"
# Default cloud-init trainee SSH public key
DEFAULT_TRAINEE_VM_CI_SSH_KEY="<trainee_vm_ci_ssh_key>"
# Tailscale auth key
INFRASTRUCTURE_TAILSCALE_AUTHKEY="<tailscale_authkey>"
# Tailscale API key
INFRASTRUCTURE_TAILSCALE_APIKEY="<tailscale_apikey>"
# Wazuh admin password
WAZUH_PASSWORD="<wazuh_password>"
# Developer mode flag for jump host Ansible packages
DEV_MODE_JUMP_HOST_ANSIBLE_PACKAGES="SKIP"
